# Получите токен у @BotFather. Никогда не публикуйте настоящий .env.
BOT_TOKEN=put_your_token_here
# Ваш Telegram ID; несколько ID перечисляются через запятую.
ADMIN_IDS=123456789
DATABASE_PATH=vpn_bot.sqlite3
# Optional: a stable HTTP(S) or SOCKS5 proxy for the Telegram API.
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Эти параметры понадобятся, когда будете подключать выдачу VPN.
# 3XUI_BASE_URL=https://vpn-panel.example.com
# 3XUI_USERNAME=admin
# 3XUI_PASSWORD=change_me
